DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mosh_dev?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (optional). Leave blank to disable the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (powers the AI Tutor). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Stripe (powers course checkout). Leave blank to keep all courses free/open —
# the Buy button and paywall only appear once a course has priceCents > 0.
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Get this from `stripe listen --print-secret` (local dev) or the Stripe
# Dashboard webhook endpoint settings (production).
STRIPE_WEBHOOK_SECRET=""
