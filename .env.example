# =============================================================================
# MOSH Chief of Staff (M-CoS) — environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Every variable here is read on the server only; none is exposed to the browser.
# See docs/ENVIRONMENT.md for the full reference.

# --- Required ----------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/mcos?schema=public"

# Session signing secret for Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# --- Required for the AI layer ------------------------------------------------
# Without this, M-CoS runs fully: dashboard, tasks, projects, CRM, goals,
# knowledge, analytics, automations and data-only reports all work. The Chief of
# Staff chat, agent runs and the AI narrative layer on reports are disabled and
# say so in the UI.

ANTHROPIC_API_KEY=""

# Optional AI tuning.
# MCOS_MODEL="claude-opus-5"
# MCOS_EFFORT="high"            # low | medium | high | xhigh | max

# --- MOSH Self-Mastery & Wealth Alignment System ------------------------------
# The self-mastery system at /mosh needs nothing beyond DATABASE_URL and
# AUTH_SECRET. Every score, chart and export in it is deterministic.

# Optional demo data for the FIRST registered account: thirty days of rhythm,
# four weeks of goals, a reviewed month, three offers with revenue, a funnel and
# twelve completed Eclipse days. Run `npm run db:seed` after registering. It
# refuses to run if that account already has entries.
# MOSH_SEED_DEMO="false"

# Optional: override the model The Billionaire Self personalises with. Without
# ANTHROPIC_API_KEY (above) it answers from its written playbook and says so.
# MOSH_MODEL="claude-opus-5"

# --- Optional workspace configuration ----------------------------------------

# MCOS_BUSINESS_SLUG="mosh-digital-studios"
# MCOS_BUSINESS_NAME="MOSH Digital Studios"
# MCOS_SEED_DEMO="true"          # set to "false" to seed without demo data

# --- Optional: Auth.js host configuration -------------------------------------
# Required when the deployment URL cannot be inferred (self-hosting, previews).

# AUTH_URL="https://cos.example.com"
# AUTH_TRUST_HOST="true"

# --- Optional: Google sign-in --------------------------------------------------
# Both must be set for the Google provider to appear.

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Optional: AI Income Academy tutor ----------------------------------------
# The learning platform that shares this codebase uses OpenAI for its tutor.

# OPENAI_API_KEY=""
# OPENAI_TUTOR_MODEL="gpt-4o-mini"

# =============================================================================
# Integrations
# =============================================================================
# An integration shows as NOT CONNECTED until its variables are set on the
# server — the status is computed from these values and cannot be faked in the
# UI. Set only the ones you actually use.

# Google (Calendar / Gmail / Drive / Sheets) — one OAuth client, per-scope tokens
# GOOGLE_CALENDAR_REFRESH_TOKEN=""
# GMAIL_REFRESH_TOKEN=""
# GOOGLE_DRIVE_REFRESH_TOKEN=""
# GOOGLE_SHEETS_REFRESH_TOKEN=""

# WhatsApp Business
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""

# Meta (Facebook Pages / Instagram)
# FACEBOOK_PAGE_ID=""
# FACEBOOK_ACCESS_TOKEN=""
# INSTAGRAM_ACCOUNT_ID=""

# LinkedIn
# LINKEDIN_ORGANIZATION_ID=""
# LINKEDIN_ACCESS_TOKEN=""

# YouTube
# YOUTUBE_CHANNEL_ID=""
# YOUTUBE_API_KEY=""

# Commerce & payments
# SHOPIFY_STORE_DOMAIN=""
# SHOPIFY_ADMIN_TOKEN=""
# PAYSTACK_SECRET_KEY=""
# SELAR_API_KEY=""
# GUMROAD_ACCESS_TOKEN=""

# Inbound automation webhooks (Zapier / Make / n8n)
# MCOS_WEBHOOK_SECRET=""
