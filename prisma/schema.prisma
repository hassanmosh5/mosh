// ---------- Integrations & approvals ----------

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  DISABLED
}

model Integration {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider      String // e.g. "google_calendar"
  displayName   String
  category      String
  status        IntegrationStatus @default(NOT_CONNECTED)
  // Only non-secret configuration is stored here. Credentials live in
  // environment variables / a secret manager and are never persisted.
  config        Json              @default("{}")
  lastCheckedAt DateTime?
  lastError     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([businessId, provider])
  @@index([businessId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  action        String // the sensitive tool/action name
  summary       String         @db.Text
  payload       Json
  agentKey      String?
  status        ApprovalStatus @default(PENDING)
  decidedAt     DateTime?
  executedAt    DateTime?
  result        String?        @db.Text
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([businessId, status])
}

// =====================================================================
// MOSH Self-Mastery & Wealth Alignment System
// =====================================================================
// Design notes:
//  * This is a *personal* operating system, so every record is scoped by
//    `userId` rather than by Business. The API layer filters on the session
//    user for every read and write; nothing here is shared between accounts.
//  * Period anchors are stored as `@db.Date` (the day, the Monday of the ISO
//    week, the first of the month) with a unique constraint per user, so
//    "today's entry" is always an upsert and can never fork into duplicates.
//  * Scores are derived, never trusted from the client. `src/lib/mosh/scoring.ts`
//    recomputes every number from the underlying records; the stored copies
//    exist only so trends can be charted without replaying history.

enum MoshPlane {
  MENTAL
  SPIRITUAL
  PHYSICAL
}

/// The five review categories used by the weekly tracker and monthly review.
/// The three planes plus the two outward-facing ones.
enum MoshLifeArea {
  MENTAL
  SPIRITUAL
  PHYSICAL
  BUSINESS
  IMPACT
}

enum MoshOfferTier {
  ATTRACTION // Tier 1 — the attraction offer
  CORE // Tier 2 — the core coaching program
  PREMIUM // Tier 3 — premium mentorship
}

enum MoshEclipsePhase {
  FOUNDATION_IN_FLOW // days 1-10
  CORE_OFFER_BIRTH // days 11-20
  VISIBILITY_EXPANSION // days 21-30
  MONEY_MODEL_ARCHITECTURE // days 31-40
  MAGNETIC_AUTHORITY // days 41-50
}

/// The patterns The Billionaire Self is trained to work with.
enum MoshPattern {
  LIMITING_BELIEF
  TRUST_ISSUE
  FEAR_OF_LOSS
  PERFECTIONISM
  INFERIORITY
  PROCRASTINATION
  LOW_DRIVE
}

enum MoshLetterKind {
  FUTURE_WISDOM
  LEGACY_LESSON
  ADVICE_TO_YOUNGER_SELF
}

/// Whether a coaching response came from the model or from the built-in
/// deterministic engine. Surfaced in the UI so guidance is never mislabelled.
enum MoshCoachSource {
  AI
  RULES
}

model MoshProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String?
  title        String    @default("Life Coach and Mindset Architect")
  philosophy   String    @default("Structure Creates Freedom.")
  mission      String?   @db.Text
  currency     String    @default("GHS")
  timezone     String    @default("Africa/Accra")
  planYear     Int?
  eclipseStart DateTime? @db.Date
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Daily ----------

model MoshDailyEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  morningRhythm   Boolean  @default(false)
  exercise        Boolean  @default(false)
  creativeWork    Boolean  @default(false)
  journaling      Boolean  @default(false)
  meditation      Boolean  @default(false)
  contentCreation Boolean  @default(false)
  trustDelegation Boolean  @default(false)
  gratitude       String?  @db.Text
  wins            String?  @db.Text
  reflection      String?  @db.Text
  energy          Int? // 1-10
  mood            Int? // 1-10
  completion      Int      @default(0) // 0-100, derived from the habit checkboxes
  alignment       Int      @default(0) // 0-100, derived daily alignment score
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// A self-rating (1-10) of one plane attribute on one day, e.g. clarity,
/// gratitude, recovery. Drives the three alignment meters on the dashboard.
model MoshPlaneCheckin {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  plane     MoshPlane
  attribute String // slug from MOSH_PLANES, e.g. "clarity"
  score     Int // 1-10
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date, attribute])
  @@index([userId, plane, date])
}

// ---------- Weekly ----------

model MoshWeeklyEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date // Monday of the ISO week
  intention String?  @db.Text
  review    String?  @db.Text
  momentum  Int      @default(0) // 0-100, derived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals MoshWeeklyGoal[]

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model MoshWeeklyGoal {
  id         String          @id @default(cuid())
  weeklyId   String
  weekly     MoshWeeklyEntry @relation(fields: [weeklyId], references: [id], onDelete: Cascade)
  area       MoshLifeArea
  goal       String          @db.Text
  progress   String?         @db.Text
  completion Int             @default(0) // 0-100
  position   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([weeklyId, area])
}

// ---------- Monthly ----------

model MoshMonthlyReview {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                 DateTime @db.Date // first day of the month
  energyGivers          String?  @db.Text
  energyDrainers        String?  @db.Text
  proudOf               String?  @db.Text
  fearsOvercome         String?  @db.Text
  service               String?  @db.Text
  structuralImprovement String?  @db.Text
  growth                Int      @default(0) // 0-100, derived
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pillars MoshMonthlyPillar[]

  @@unique([userId, month])
  @@index([userId, month])
}

model MoshMonthlyPillar {
  id           String            @id @default(cuid())
  reviewId     String
  review       MoshMonthlyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  area         MoshLifeArea
  goals        String?           @db.Text
  achievements String?           @db.Text
  lessons      String?           @db.Text
  score        Int               @default(0) // 0-100 self-assessed
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([reviewId, area])
}

// ---------- 365-day master plan ----------

model MoshYearPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  theme     String?
  vision    String?  @db.Text
  northStar String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quarters MoshQuarter[]

  @@unique([userId, year])
}

model MoshQuarter {
  id            String       @id @default(cuid())
  yearPlanId    String
  yearPlan      MoshYearPlan @relation(fields: [yearPlanId], references: [id], onDelete: Cascade)
  quarter       Int // 1-4
  title         String
  focus         String[]     @default([])
  goal          String       @db.Text
  progress      Int          @default(0) // 0-100
  revenueTarget Decimal?     @db.Decimal(14, 2)
  clientTarget  Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  milestones MoshMilestone[]

  @@unique([yearPlanId, quarter])
}

model MoshMilestone {
  id          String      @id @default(cuid())
  quarterId   String
  quarter     MoshQuarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  monthOffset Int // 1-3 within the quarter
  title       String
  detail      String?     @db.Text
  done        Boolean     @default(false)
  dueDate     DateTime?   @db.Date
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([quarterId, monthOffset])
}

// ---------- Business: the three-tier offer ecosystem ----------

model MoshOffer {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      MoshOfferTier
  name      String
  promise   String?       @db.Text
  price     Decimal       @default(0) @db.Decimal(14, 2)
  currency  String        @default("GHS")
  active    Boolean       @default(true)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  metrics MoshOfferMetric[]

  @@unique([userId, tier, name])
  @@index([userId, tier])
}

/// One month of reported performance for one offer. The tier decides which
/// columns matter; the UI only asks for the ones that belong to that tier.
model MoshOfferMetric {
  id             String    @id @default(cuid())
  offerId        String
  offer          MoshOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  month          DateTime  @db.Date // first day of the month
  revenue        Decimal   @default(0) @db.Decimal(14, 2)
  // Tier 1 — attraction
  leads          Int       @default(0)
  conversions    Int       @default(0)
  subscribers    Int       @default(0)
  downloads      Int       @default(0)
  // Tier 2 — core program
  students       Int       @default(0)
  satisfaction   Int? // 0-100
  completionRate Int? // 0-100
  // Tier 3 — premium mentorship
  clients        Int       @default(0)
  retention      Int? // 0-100
  transformation Int? // 0-100
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([offerId, month])
  @@index([offerId, month])
}

// ---------- Customer funnel ----------

model MoshFunnelSnapshot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  visitors    Int      @default(0)
  leads       Int      @default(0)
  subscribers Int      @default(0)
  customers   Int      @default(0)
  students    Int      @default(0)
  mentorship  Int      @default(0)
  advocates   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------- 50-Day Eclipse Growth Strategy ----------

model MoshEclipseDay {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         Int // 1-50
  phase       MoshEclipsePhase
  focus       String
  action      String           @db.Text
  done        Boolean          @default(false)
  note        String?          @db.Text
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, day])
  @@index([userId, phase])
}

// ---------- The Billionaire Self (self-coaching) ----------

model MoshCoachSession {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern         MoshPattern
  situation       String          @db.Text
  analysis        String          @db.Text
  encouragement   String          @db.Text
  actions         Json            @default("[]") // string[]
  prompts         Json            @default("[]") // string[]
  recommendations Json            @default("[]") // string[]
  source          MoshCoachSource @default(RULES)
  model           String?
  createdAt       DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, pattern])
}

// ---------- A Message From My 77-Year-Old Self ----------

model MoshLegacyLetter {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      MoshLetterKind @default(FUTURE_WISDOM)
  title     String
  body      String         @db.Text
  pinned    Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, createdAt])
}

// ---------- Storefront: sales and download fulfilment ----------
//
// Digital delivery for the standalone products sold on Gumroad, Selar,
// Shopify, Paystack and WhatsApp Business. Gumroad and Selar deliver their own
// files, so their webhooks exist to mirror the sale; Shopify, Paystack and
// WhatsApp rely on the download grant below for delivery.

enum SalesPlatform {
  GUMROAD
  SELAR
  SHOPIFY
  PAYSTACK
  WHATSAPP
  MANUAL
}

enum SaleStatus {
  PAID
  REFUNDED
  CANCELLED
}

model Sale {
  id          String        @id @default(cuid())
  platform    SalesPlatform
  /// The platform's own identifier: Gumroad sale_id, Shopify order id,
  /// Paystack reference, or the mobile-money transaction id for WhatsApp.
  reference   String
  email       String
  productSlug String
  tier        String
  /// Amount in the currency's minor unit (pesewas, kobo, cents).
  amountMinor Int
  currency    String
  status      SaleStatus    @default(PAID)
  /// The verified webhook body, kept for reconciliation and disputes.
  payload     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  grants DownloadGrant[]

  // One sale per platform reference: replayed webhooks must not sell twice.
  @@unique([platform, reference])
  @@index([email])
  @@index([productSlug, createdAt])
}

model DownloadGrant {
  id            String    @id @default(cuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productSlug   String
  tier          String
  /// SHA-256 of the download token. The token itself is never stored, so a
  /// database leak cannot be turned into working download links.
  tokenHash     String    @unique
  maxDownloads  Int
  downloadCount Int       @default(0)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  downloads DownloadEvent[]

  @@index([saleId])
  @@index([expiresAt])
}

model DownloadEvent {
  id        String        @id @default(cuid())
  grantId   String
  grant     DownloadGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([grantId, createdAt])
}
